{
    "name": "RISU CUSTOM DEV",
    "icons": [
        {
            "src": "/icon/custom-192.png",
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": "/icon/custom-512.png",
            "type": "image/png",
            "sizes": "512x512"
        }
    ],
    "start_url": "/",
    "display": "standalone",
    "theme_color": "#CCFF18",
    "share_target": {
        "action": "/receive-files/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "character",
                    "accept": [
                        ".charx"
                    ]
                },
                {
                    "name": "preset",
                    "accept": [
                        ".risup"
                    ]
                },
                {
                    "name": "module",
                    "accept": [
                        ".risum"
                    ]
                }
            ]
        }
    },
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "application/octet-stream": [
                    ".charx",
                    ".risup",
                    ".risum"
                ]
            }
        }
    ],
    "short_name": "RISU CUSTOM"
}
